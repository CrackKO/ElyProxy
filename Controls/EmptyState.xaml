<UserControl x:Class="ElyProxy.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <StackPanel HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="380"
              Margin="24">
    <Border x:Name="GlyphRing"
            Width="78"
            Height="78"
            CornerRadius="39"
            Background="{DynamicResource FillTertiaryBrush}"
            HorizontalAlignment="Center">
      <Path Data="{Binding Glyph, ElementName=Root}"
            Width="34"
            Height="34"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stroke="{DynamicResource FgDimBrush}"
            StrokeThickness="1.1"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            StrokeLineJoin="Round" />
    </Border>
    <TextBlock Text="{Binding Title, ElementName=Root}"
               Style="{StaticResource Text.Title}"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,14,0,0" />
    <TextBlock x:Name="DescriptionText"
               Text="{Binding Description, ElementName=Root}"
               Style="{StaticResource Text.Callout}"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,6,0,0" />
    <Button Content="{Binding ActionText, ElementName=Root}"
            Command="{Binding ActionCommand, ElementName=Root}"
            HorizontalAlignment="Center"
            Margin="0,18,0,0">
      <Button.Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
  </StackPanel>
</UserControl>

<Application x:Class="ElyProxy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.Dark.xaml" />
        <ResourceDictionary Source="Theme/Typography.xaml" />
        <ResourceDictionary Source="Theme/Converters.xaml" />
        <ResourceDictionary Source="Theme/Controls/Buttons.xaml" />
        <ResourceDictionary Source="Theme/Controls/Inputs.xaml" />
        <ResourceDictionary Source="Theme/Controls/Lists.xaml" />
        <ResourceDictionary Source="Theme/Controls/Menus.xaml" />
        <ResourceDictionary Source="Theme/Controls/Surfaces.xaml" />
        <ResourceDictionary Source="Theme/Controls/Shell.xaml" />
        <ResourceDictionary Source="Theme/Controls/Hints.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

<Window x:Class="ElyProxy.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElyProxy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <Style x:Key="TrayMenuItem" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource MaterialThickBrush}"
          BorderBrush="{DynamicResource BorderBr}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="4"
          Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.35" />
    </Border.Effect>
    <StackPanel MinWidth="180">
      <TextBlock Text="ElyProxy"
                 Style="{StaticResource Text.CaptionStrong}"
                 Margin="12,8,12,4" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="Показать"
              Click="Show_Click"
              AutomationProperties.Name="Показать окно ElyProxy" />
      <Border Style="{StaticResource AppleRowSeparator}" Margin="8,4" />
      <TextBlock Text="Ядро TUN"
                 Style="{StaticResource Text.Caption}"
                 Margin="12,4,12,2" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="sing-box"
              Tag="0"
              Click="TunCore_Click"
              AutomationProperties.Name="Ядро TUN: sing-box" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="Xray TUN"
              Tag="1"
              Click="TunCore_Click"
              AutomationProperties.Name="Ядро TUN: Xray" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="tun2proxy"
              Tag="2"
              Click="TunCore_Click"
              AutomationProperties.Name="Ядро TUN: tun2proxy" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="Hysteria 2 TUN"
              Tag="3"
              Click="TunCore_Click"
              AutomationProperties.Name="Ядро TUN: Hysteria 2" />
      <Border Style="{StaticResource AppleRowSeparator}" Margin="8,4" />
      <Button Style="{StaticResource TrayMenuItem}"
              Content="Выход"
              Click="Exit_Click"
              AutomationProperties.Name="Выйти из ElyProxy" />
    </StackPanel>
  </Border>
</Window>

<Window x:Class="ElyProxy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:ElyProxy.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ElyProxy"
        Icon="pack://application:,,,/ElyProxy;component/icon.ico"
        Width="1080"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg1Brush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================= Title bar ============================= -->
    <Grid Grid.Row="0"
          x:Name="TitleBarGrid"
          Background="{DynamicResource ShellSurfaceBrush}"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0"
                  IsHitTestVisible="False">
        <Image Width="18"
               Height="18"
               Margin="0,0,9,0"
               VerticalAlignment="Center"
               Source="pack://application:,,,/ElyProxy;component/icon.ico"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="ElyProxy" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        <controls:BusyRing Width="16"
                     Height="16"
                     Margin="10,1,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <!-- No pill background here: a translucent capsule reads as an odd outline
           over the shell surface. Just the status dot and text. -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  IsHitTestVisible="False">
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
          <Ellipse.Style>
            <Style TargetType="{x:Type Ellipse}">
              <Setter Property="Fill" Value="{DynamicResource FgDimBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding StatusText}"
                   Style="{StaticResource PillText}"
                   VerticalAlignment="Center"
                   MaxWidth="260"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding StatusText}" />
        <TextBlock Text="{Binding ConnectedNodeName}"
                   Style="{StaticResource PillText}"
                   Foreground="{DynamicResource FgDimBrush}"
                   Margin="8,0,0,0"
                   MaxWidth="220"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ConnectedNodeName}"
                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
        <Button Style="{StaticResource LinkButton}"
                Margin="0,0,10,0"
                Command="{Binding CheckForUpdatesCommand}"
                ToolTip="{Binding UpdateStatus}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7"
                     Height="7"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"
                     Fill="{Binding UpdateBadgeBrush}" />
            <TextBlock Text="{Binding UpdateBadgeText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButton}"
                Width="30"
                Height="30"
                Command="{Binding OpenTelegramCommand}"
                ToolTip="Telegram"
                AutomationProperties.Name="Открыть Telegram">
          <Grid>
            <Ellipse Width="24" Height="24" Fill="#FF229ED9" />
            <Path Data="{StaticResource Icon.TelegramPlane}"
                   Fill="#FFFFFFFF"
                   Width="14"
                   Height="14"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Style="{StaticResource IconButton}"
                Width="30"
                Height="30"
                Margin="4,0,0,0"
                Command="{Binding OpenDiscordCommand}"
                ToolTip="Discord"
                AutomationProperties.Name="Открыть Discord">
          <Grid>
            <Ellipse Width="24" Height="24" Fill="#FF5865F2" />
            <Path Data="{StaticResource Icon.DiscordFace}"
                   Fill="#FFFFFFFF"
                   Width="14"
                   Height="14"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Border Width="1" Height="18" Margin="10,0,4,0" Background="{DynamicResource BorderBr}" />
        <Button x:Name="MinimizeButton"
                Style="{StaticResource CaptionButton}"
                Click="MinimizeButton_Click"
                AutomationProperties.Name="Свернуть">
          <Path Data="{StaticResource Icon.Minimize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2"
                Width="11"
                Height="11"
                Stretch="Uniform" />
        </Button>
        <Button x:Name="MaximizeButton"
                Style="{StaticResource CaptionButton}"
                Click="MaximizeButton_Click"
                AutomationProperties.Name="Развернуть">
          <Path x:Name="MaximizeGlyph"
                Data="{StaticResource Icon.Maximize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2"
                Width="10"
                Height="10"
                Stretch="Uniform" />
        </Button>
        <Button x:Name="CloseButton"
                Style="{StaticResource CaptionCloseButton}"
                Click="CloseButton_Click"
                AutomationProperties.Name="Закрыть">
          <Path Data="{StaticResource Icon.Close}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2"
                Width="10"
                Height="10"
                Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ============================= Body ============================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Style="{StaticResource SidebarSurface}">
        <Grid Margin="10,4,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource AppleCard}" Padding="14,13" Margin="0,4,0,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="1,4,9,0" VerticalAlignment="Top">
                  <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                      <Setter Property="Fill" Value="{DynamicResource FgDimBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                          <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Style="{StaticResource Text.BodyStrong}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           ToolTip="{Binding StatusText}" />
              </Grid>
              <!-- Two lines with an ellipsis on the last one: server names are long. -->
              <TextBlock Text="{Binding ConnectedNodeName}"
                         Style="{StaticResource Text.Caption}"
                         Margin="20,4,0,0"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         MaxHeight="36"
                         ToolTip="{Binding ConnectedNodeName}" />

              <Button Content="Подключить"
                      Style="{StaticResource PrimaryButton}"
                      Margin="0,10,0,0"
                      Command="{Binding ConnectCommand}"
                      Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}" />
              <Button Content="Отключить"
                      Style="{StaticResource SecondaryButton}"
                      Margin="0,10,0,0"
                      Command="{Binding DisconnectCommand}"
                      Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </Border>

          <ListBox x:Name="NavList"
                   Grid.Row="1"
                   Style="{StaticResource SidebarNavList}"
                   SelectionChanged="NavList_SelectionChanged">
            <ListBoxItem AutomationProperties.Name="Серверы">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource NavIcon}" Data="{StaticResource Icon.Servers}" />
                <TextBlock Text="Серверы" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Подписки">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource NavIcon}" Data="{StaticResource Icon.Subscriptions}" />
                <TextBlock Text="Подписки" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Профили">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource NavIcon}" Data="{StaticResource Icon.Profiles}" />
                <TextBlock Text="Профили" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Настройки">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource NavIcon}" Data="{StaticResource Icon.Settings}" />
                <TextBlock Text="Настройки" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="2,8,2,0">
            <Button Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left"
                    Command="{Binding CheckForUpdatesCommand}"
                    ToolTip="{Binding UpdateStatus}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6"
                         Height="6"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         Fill="{Binding UpdateBadgeBrush}" />
                <TextBlock Text="{Binding UpdateBadgeText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding ApplicationVersion}"
                       Style="{StaticResource Text.Micro}"
                       Margin="2,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Content column -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ContentSurface}">
          <ContentControl x:Name="SectionHost" />
        </Border>

        <!-- Log drawer -->
        <Border x:Name="LogDrawer"
                Grid.Row="1"
                Height="0"
                Background="{DynamicResource Bg2Brush}"
                BorderBrush="{DynamicResource BorderBr}"
                BorderThickness="0,1,0,0"
                ClipToBounds="True">
          <Grid x:Name="LogDrawerContent" Margin="14,10,14,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Журнал"
                           Style="{StaticResource Text.Headline}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <controls:BusyRing Width="16"
                             Height="16"
                             Margin="10,2,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="LogSearchBox"
                         Width="170"
                         MinHeight="30"
                         Margin="0,0,8,0"
                         controls:Placeholder.Text="Поиск по журналу"
                         AutomationProperties.Name="Поиск по журналу"
                         TextChanged="LogFilter_Changed" />
                <ComboBox x:Name="LogLevelBox"
                          MinWidth="150"
                          MinHeight="30"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Фильтр по уровню"
                          SelectionChanged="LogFilter_Changed">
                  <ComboBoxItem Content="Все уровни" IsSelected="True" />
                  <ComboBoxItem Content="Ошибки" />
                  <ComboBoxItem Content="Предупреждения" />
                  <ComboBoxItem Content="Система" />
                </ComboBox>
                <Button Content="Копировать"
                        Style="{StaticResource ToolbarButton}"
                        Margin="0,0,4,0"
                        Click="CopyLog_Click"
                        AutomationProperties.Name="Копировать журнал" />
                <Button Content="Очистить"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding ClearLogCommand}"
                        AutomationProperties.Name="Очистить журнал" />
              </WrapPanel>
            </Grid>
            <TextBox x:Name="LogBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="{StaticResource AppMonoFontFamily}"
                     FontSize="11.5"
                     Foreground="{DynamicResource FgSecBrush}"
                     Background="{DynamicResource Bg1Brush}"
                     BorderBrush="Transparent"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="LogBox_TextChanged" />
          </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Height="32"
                Background="{DynamicResource ShellSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBr}"
                BorderThickness="0,1,0,0">
          <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                <Ellipse.Style>
                  <Style TargetType="{x:Type Ellipse}">
                    <Setter Property="Fill" Value="{DynamicResource FgDimBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding StatusText}"
                         Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource FgBrush}"
                         MaxWidth="220"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding StatusText}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding ConnectionInfo}"
                       Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ConnectionInfo}"
                       Margin="16,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Caption}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         Visibility="{Binding IsTrafficMonitorActive, Converter={StaticResource BoolToVis}}">
                <TextBlock.ToolTip>
                  <StackPanel MaxWidth="320">
                    <TextBlock Text="Скорость и трафик текущей сессии"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SessionTrafficText}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Счётчики показывают, сколько скачано и отправлено с момента подключения, и сбрасываются при каждом новом подключении. Доступно для ядер sing-box; для Xray и Hysteria 2 скорость не измеряется."
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </TextBlock.ToolTip>
                <Run Text="↓ " Foreground="{DynamicResource GreenBrush}" />
                <Run Text="{Binding DownloadSpeedText, Mode=OneWay}" />
                <Run Text="  ↑ " Foreground="{DynamicResource AccentBrush}" />
                <Run Text="{Binding UploadSpeedText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center">
                <Run Text="SOCKS5 " />
                <Run Text="{Binding SocksPort, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
              </TextBlock>
              <TextBlock Style="{StaticResource Text.Micro}"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         Visibility="{Binding ActiveConfigHashText, Converter={StaticResource StringToVis}}"
                         ToolTip="Короткий SHA-256 применённого конфига. Позволяет убедиться, что настройки действительно применились: то же значение выводится в журнале при запуске ядра.">
                <Run Text="{Binding ActiveConfigHashText, Mode=OneWay}" />
              </TextBlock>
              <Button x:Name="LogToggleButton"
                      Style="{StaticResource IconButton}"
                      Width="26"
                      Height="26"
                      Margin="10,0,0,0"
                      Click="LogToggleButton_Click"
                      ToolTip="Журнал"
                      AutomationProperties.Name="Показать журнал">
                <Path Style="{StaticResource ToolbarIcon}" Width="15" Height="15" Data="{StaticResource Icon.Log}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <controls:SheetHost x:Name="SheetHost" Grid.RowSpan="2" />
    <controls:ToastHost x:Name="ToastHost"
                        Grid.RowSpan="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="0,58,18,0" />
  </Grid>
</Window>

<UserControl x:Class="ElyProxy.Views.Sections.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ElyProxy.Controls">
  <UserControl.Resources>
    <ContextMenu x:Key="ProfileRowMenu"
                 x:Shared="False"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Экспорт профиля (.elyproxy)" Command="{Binding ExportProfileCommand}" />
      <MenuItem Header="Экспорт Clash YAML" Click="ExportClash_Click" />
      <MenuItem Header="Экспорт JSON (Xray outbounds)" Click="ExportJson_Click" />
      <MenuItem Header="Импорт серверов из файла…" Click="ImportFile_Click" />
      <Separator />
      <MenuItem Header="Удалить профиль" Click="DeleteProfileRow_Click" />
    </ContextMenu>

    <ContextMenu x:Key="ProfileNodeRowMenu"
                 x:Shared="False"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Подключить" Command="{Binding ConnectFromProfileCommand}" />
      <MenuItem Header="Убрать из профиля" Command="{Binding RemoveFromProfileCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Профили" Style="{StaticResource Text.LargeTitle}" />
        <TextBlock Text="Наборы серверов для быстрого переключения"
                   Style="{StaticResource Text.Caption}"
                   Margin="1,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Импорт"
                Style="{StaticResource ToolbarButton}"
                MinHeight="34"
                Padding="12,7"
                Command="{Binding ImportProfileCommand}"
                AutomationProperties.Name="Импортировать профиль" />
        <Button Content="Экспорт"
                Style="{StaticResource ToolbarButton}"
                Margin="4,0,0,0"
                MinHeight="34"
                Padding="12,7"
                Command="{Binding ExportProfileCommand}"
                AutomationProperties.Name="Экспортировать профиль" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Profiles -->
      <Grid Grid.Column="0" Margin="0,0,14,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox controls:Placeholder.Text="Новый профиль"
                   Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1"
                  Style="{StaticResource PrimaryButton}"
                  Margin="8,0,0,0"
                  Padding="11,7"
                  Command="{Binding CreateProfileCommand}"
                  ToolTip="Создать профиль"
                  AutomationProperties.Name="Создать профиль">
            <Path Style="{StaticResource ToolbarIcon}"
                  Width="14"
                  Height="14"
                  Stroke="{DynamicResource OnAccentBrush}"
                  Data="{StaticResource Icon.Plus}" />
          </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource AppleInsetGroup}">
          <ListBox Style="{StaticResource AppleList}"
                   ItemsSource="{Binding Profiles}"
                   SelectedItem="{Binding SelectedProfile}"
                   PreviewMouseRightButtonDown="ProfilesList_PreviewMouseRightButtonDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ContextMenu="{StaticResource ProfileRowMenu}">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}" />
                    <Run Text="серверов" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Button Grid.Row="2"
                Content="Удалить профиль"
                Style="{StaticResource DestructiveGhostButton}"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Click="DeleteProfile_Click"
                AutomationProperties.Name="Удалить выбранный профиль" />
      </Grid>

      <!-- Profile nodes -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Border Style="{StaticResource AppleInsetGroup}"
                  Visibility="{Binding ProfileNodes.Count, Converter={StaticResource NonZeroToVis}}">
            <ListView Style="{StaticResource AppleListView}"
                      ItemsSource="{Binding ProfileNodes}"
                      SelectedItem="{Binding SelectedProfileNode}"
                      PreviewMouseRightButtonDown="ProfileNodesList_PreviewMouseRightButtonDown">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ContextMenu="{StaticResource ProfileNodeRowMenu}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{DynamicResource FillTertiaryBrush}"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding DataContext.ServerBadgeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BadgeVis}}">
                      <Grid>
                        <Image Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True">
                          <Image.Source>
                            <MultiBinding Converter="{StaticResource FlagImage}">
                              <Binding Path="DisplayName" />
                              <Binding Path="DataContext.ServerBadgeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                          </Image.Source>
                          <Image.Clip>
                            <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                          </Image.Clip>
                        </Image>
                        <TextBlock Style="{StaticResource Text.CaptionStrong}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource BadgeText}">
                              <Binding Path="DisplayName" />
                              <Binding Path="DataContext.ServerBadgeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding Address, Mode=OneWay}" />
                        <Run Text=":" />
                        <Run Text="{Binding Port, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0">
                      <TextBlock Text="{Binding TransportDisplay}" Style="{StaticResource ChipText}" />
                    </Border>
                    <TextBlock Grid.Column="3"
                               Text="{Binding LatencyDisplay}"
                               Style="{StaticResource Text.Caption}"
                               MinWidth="72"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Border>

          <controls:SkeletonList Rows="5">
            <controls:SkeletonList.Visibility>
              <MultiBinding Converter="{StaticResource BoolAndZeroToVis}">
                <Binding Path="IsLoading" />
                <Binding Path="ProfileNodes.Count" />
              </MultiBinding>
            </controls:SkeletonList.Visibility>
          </controls:SkeletonList>

          <controls:EmptyState Glyph="{StaticResource Icon.Profiles}"
                               Title="Профиль пуст"
                               Description="Выберите профиль слева и добавьте в него серверы кнопкой «В профиль» на вкладке «Серверы»."
                               Visibility="{Binding ProfileNodes.Count, Converter={StaticResource ZeroToVis}}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Подключить"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding ConnectFromProfileCommand}"
                  AutomationProperties.Name="Подключиться к выбранному серверу профиля" />
          <Button Content="Убрать"
                  Style="{StaticResource SecondaryButton}"
                  Margin="6,0,0,0"
                  Command="{Binding RemoveFromProfileCommand}"
                  AutomationProperties.Name="Убрать сервер из профиля" />
          <Button Content="Очистить"
                  Style="{StaticResource DestructiveGhostButton}"
                  Margin="6,0,0,0"
                  Click="ClearProfile_Click"
                  AutomationProperties.Name="Очистить профиль" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

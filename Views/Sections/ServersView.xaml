<UserControl x:Class="ElyProxy.Views.Sections.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ElyProxy.Controls"
             xmlns:converters="clr-namespace:ElyProxy.Controls.Converters">
  <UserControl.Resources>
    <converters:EqualsToVisibilityConverter x:Key="EqualsToVis" />

    <ContextMenu x:Key="ServerRowMenu"
                 x:Shared="False"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Подключить" Command="{Binding ConnectCommand}" />
      <MenuItem Header="В профиль" Command="{Binding AddToProfileCommand}" />
      <Separator />
      <MenuItem Header="Копировать прокси" Command="{Binding CopyProxyCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Серверы" Style="{StaticResource Text.LargeTitle}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="1,4,0,0">
          <Run Text="{Binding AllNodes.Count, Mode=OneWay}" />
          <Run Text="серверов доступно" />
        </TextBlock>
      </StackPanel>
      <Button Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Click="AddServer_Click"
              AutomationProperties.Name="Добавить сервер вручную">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource ToolbarIcon}"
                Width="14"
                Height="14"
                Stroke="{DynamicResource OnAccentBrush}"
                Data="{StaticResource Icon.Plus}" />
          <TextBlock Text="Добавить" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Connection mode: the same control also lives in the sidebar -->
    <Border Grid.Row="1" Style="{StaticResource AppleInsetGroup}" Padding="14,12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Режим подключения" Style="{StaticResource Text.BodyStrong}" />
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
                <Setter Property="Text" Value="Выключено — трафик идёт напрямую." />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SystemProxyEnabled}" Value="True">
                    <Setter Property="Text" Value="Proxy Lite — системный PAC-прокси: через сервер идёт только выбранный трафик." />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ProxyProEnabled}" Value="True">
                    <Setter Property="Text" Value="Proxy Pro — системный HTTP/HTTPS/SOCKS-прокси через sing-box для приложений, которые используют настройки прокси Windows." />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ElyTunEnabled}" Value="True">
                    <Setter Property="Text" Value="ElyTun — полный TUN-туннель на базе sing-box. Нужны права администратора." />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
         <controls:ModeSelector Grid.Column="1"
                                Width="352"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Режим подключения"
                                ElyTunRequestCommand="{Binding RequestElyTunCommand}"
                                ProxyLiteEnabled="{Binding SystemProxyEnabled, Mode=TwoWay}"
                               ProxyProEnabled="{Binding ProxyProEnabled, Mode=TwoWay}"
                               ElyTunEnabled="{Binding ElyTunEnabled, Mode=TwoWay}" />
      </Grid>
    </Border>

    <!-- Filter bar -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBox x:Name="SearchBox"
                 Width="210"
                 controls:Placeholder.Text="Поиск"
                 AutomationProperties.Name="Поиск по серверам"
                 TextChanged="SearchBox_TextChanged" />
        <ComboBox x:Name="SortBox"
                  MinWidth="170"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="Сортировка серверов"
                  SelectionChanged="SortBox_SelectionChanged">
          <ComboBoxItem Content="Как в подписке" IsSelected="True" />
          <ComboBoxItem Content="По имени" />
          <ComboBoxItem Content="По задержке" />
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Пинг"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding PingAllCommand}"
                AutomationProperties.Name="Пинг всех серверов" />
        <Button Content="Проверить соединение"
                Style="{StaticResource SecondaryButton}"
                Margin="8,0,0,0"
                Command="{Binding RunConnectionDiagnosticsCommand}"
                AutomationProperties.Name="Проверить соединение и скопировать безопасный отчёт" />
      </StackPanel>
    </Grid>

    <!-- Server list -->
    <Grid Grid.Row="3">
      <ListView Style="{StaticResource AppleListView}"
                ItemsSource="{Binding AllNodes}"
                SelectedItem="{Binding SelectedNode}"
                PreviewMouseRightButtonDown="ServerList_PreviewMouseRightButtonDown"
                Visibility="{Binding AllNodes.Count, Converter={StaticResource NonZeroToVis}}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  ContextMenu="{StaticResource ServerRowMenu}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0"
                      Width="30"
                      Height="30"
                      CornerRadius="15"
                      Background="{DynamicResource FillTertiaryBrush}"
                      Margin="0,0,11,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding DataContext.ServerBadgeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BadgeVis}}">
                <TextBlock Style="{StaticResource Text.CaptionStrong}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource BadgeText}">
                      <Binding Path="DisplayName" />
                      <Binding Path="DataContext.ServerBadgeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}"
                           Style="{StaticResource Text.Body}"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                  <Run Text="{Binding Address, Mode=OneWay}" />
                  <Run Text=":" />
                  <Run Text="{Binding Port, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <!-- Connected marker: a plain green check (the Wi-Fi list pattern)
                   instead of a filled pill. -->
              <Path Grid.Column="2"
                    Data="{StaticResource Icon.Check}"
                    Stroke="{DynamicResource GreenBrush}"
                    StrokeThickness="2.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    ToolTip="Подключено"
                    AutomationProperties.Name="Подключено">
                <Path.Visibility>
                  <MultiBinding Converter="{StaticResource EqualsToVis}">
                    <Binding Path="DisplayName" />
                    <Binding Path="DataContext.ConnectedNodeName" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                  </MultiBinding>
                </Path.Visibility>
              </Path>
              <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="8,0">
                <TextBlock Text="{Binding TransportDisplay}" Style="{StaticResource ChipText}" />
              </Border>
              <TextBlock Grid.Column="4"
                         Text="{Binding LatencyDisplay}"
                         Style="{StaticResource Text.Caption}"
                         MinWidth="72"
                         TextAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <controls:SkeletonList Rows="6">
        <controls:SkeletonList.Visibility>
          <MultiBinding Converter="{StaticResource BoolAndZeroToVis}">
            <Binding Path="IsLoading" />
            <Binding Path="AllNodes.Count" />
          </MultiBinding>
        </controls:SkeletonList.Visibility>
      </controls:SkeletonList>

      <controls:EmptyState x:Name="EmptyServers"
                           Glyph="{StaticResource Icon.Servers}"
                           Title="Серверов пока нет"
                           Description="Добавьте VLESS-подписку, выберите сервер и подключитесь. Для Proxy Pro и ElyTun нужен sing-box; ElyTun при включении запросит права администратора."
                           ActionText="Добавить подписку"
                           Visibility="{Binding AllNodes.Count, Converter={StaticResource ZeroToVis}}" />
    </Grid>

    <!-- Row actions -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Проверить компоненты"
                Style="{StaticResource GhostButton}"
                Command="{Binding CheckRuntimeComponentsCommand}"
                Visibility="{Binding AllNodes.Count, Converter={StaticResource ZeroToVis}}"
                AutomationProperties.Name="Проверить наличие Xray, sing-box и rule-set файлов" />
        <Button Content="В профиль"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding AddToProfileCommand}"
                AutomationProperties.Name="Добавить выбранный сервер в профиль" />
        <Button Content="Копировать прокси"
                Style="{StaticResource GhostButton}"
                Margin="6,0,0,0"
                Command="{Binding CopyProxyCommand}"
                AutomationProperties.Name="Копировать адрес прокси" />
        <Button Content="Копировать отчёт"
                Style="{StaticResource GhostButton}"
                Margin="6,0,0,0"
                Command="{Binding CopyDiagnosticsCommand}"
                Visibility="{Binding HasDiagnosticsReport, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Копировать безопасный отчёт диагностики" />
      </StackPanel>
      <TextBlock Text="{Binding PingSummary}"
                 Style="{StaticResource Text.Caption}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 MaxWidth="420"
                 TextTrimming="CharacterEllipsis"
                 Visibility="{Binding HasPingSummary, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Grid>
</UserControl>

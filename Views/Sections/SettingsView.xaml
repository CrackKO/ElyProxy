<ListView BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" Background="{DynamicResource CardBrush}" ItemsSource="{Binding DpiTrials}" SelectedItem="{Binding SelectedDpiTrial}" MaxHeight="260" Margin="0,8,0,8" AutomationProperties.Name="Результаты подбора DPI">

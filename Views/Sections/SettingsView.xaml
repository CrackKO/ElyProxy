<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:ElyProxy.Controls.Behaviors" xmlns:controls="clr-namespace:ElyProxy.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ElyProxy.Views.Sections.SettingsView" Background="{DynamicResource Bg1Brush}">
  <UserControl.Resources>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}" />
      <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" Background="{DynamicResource CardBrush}" HorizontalContentAlignment="Left" Padding="16,12">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Chevron" Text="›" Margin="0,0,10,0" Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="Text" Value="⌄" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding Header}" />
              </ToggleButton>
              <ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,10,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBr}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style x:Key="AppleSettingRow" TargetType="Border">
      <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsTab" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="13,19" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Hover" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <Border x:Name="Line" Height="4" CornerRadius="3,3,0,0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Selected">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource FillSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="{x:Type controls:SpringToggleSwitch}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppleFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type controls:SpringToggleSwitch}">
            <Border x:Name="Track" Width="52" Height="30" CornerRadius="15" Background="{DynamicResource FillBrush}" SnapsToDevicePixels="True">
              <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SwitchThumbBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">

            </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="TravelDistance" Value="22" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="26,22,26,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Настройки" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" />
        <TextBlock Text="Всё необходимое — в своём разделе" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="1,5,0,0" Visibility="Collapsed" />
      </StackPanel>
      <Grid Grid.Column="1">
        <TextBox x:Name="SettingsSearch" VerticalAlignment="Center" controls:Placeholder.Text="Найти настройку…" AutomationProperties.Name="Поиск настроек" TextChanged="Search_TextChanged" MinHeight="40" FontSize="15" Padding="38,10,12,10" />
        <TextBlock Text="⌕" FontSize="27" Foreground="{DynamicResource FgSecBrush}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" Panel.ZIndex="1" />
      </Grid>
    </Grid>
    <StackPanel Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal">
          <Button Content="Оформление" Tag="AppearanceAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Защита" Tag="ProtectionAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Запуск" Tag="StartupAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Сеть" Tag="NetworkAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Обновления" Tag="UpdatesAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="ElyTun" Tag="TunAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Обход DPI" Tag="DpiAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Ядра" Tag="CoresAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Подписки" Tag="SubscriptionsAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
          <Button Content="Разделение трафика" Tag="RoutingAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
        </StackPanel>
      </ScrollViewer>
      <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
      <ListBox x:Name="SearchResults" Visibility="Collapsed" MaxHeight="180" DisplayMemberPath="Title" SelectionChanged="SearchResults_SelectionChanged" Margin="0,4,0,12" />
    </StackPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" behaviors:SmoothScroll.IsEnabled="True">
      <StackPanel x:Name="SettingsPages" MaxWidth="1320" HorizontalAlignment="Stretch" Margin="0,0,4,0">
        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
          <TextBlock x:Name="AppearanceAnchor" Text="Оформление" Style="{StaticResource SettingsSectionTitle}" Margin="0,26,0,5" />
          <TextBlock Text="Внешний вид и поведение интерфейса." FontSize="15" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
          <Grid Tag="SettingsColumns" SizeChanged="SettingsColumns_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.65*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,16,0" Tag="1.65">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Text="Внешний вид" FontSize="23" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="22,16,22,16" />
                  <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
                  <Border Style="{StaticResource AppleSettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Тема" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="Светлая, тёмная или как в Windows" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Width="250" HorizontalAlignment="Right" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Тема оформления" ItemsSource="{Binding ThemeModeOptions}" SelectedValue="{Binding ThemeMode, Mode=TwoWay}" FontSize="15" MinHeight="40" />
                    </Grid>
                  </Border>
                  <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
                  <Border Style="{StaticResource AppleSettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Анимации" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="Пружинные переходы; отключаются в режиме экономии" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Width="250" HorizontalAlignment="Right" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Анимации интерфейса" ItemsSource="{Binding MotionModeOptions}" SelectedValue="{Binding MotionMode, Mode=TwoWay}" FontSize="15" MinHeight="40" />
                    </Grid>
                  </Border>
                  <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
                  <Border Style="{StaticResource AppleSettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Аватар сервера" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="Метка слева от названия в списках серверов и профилей" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Width="250" HorizontalAlignment="Right" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Аватар сервера" ItemsSource="{Binding ServerBadgeOptions}" SelectedValue="{Binding ServerBadgeMode, Mode=TwoWay}" FontSize="15" MinHeight="40" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Text="Журнал" FontSize="23" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="22,16,22,16" />
                  <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
                  <Border Style="{StaticResource AppleSettingRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Показывать журнал" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="Сворачиваемая панель внизу окна (Ctrl+L)" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <controls:SpringToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Показывать журнал" IsChecked="{Binding ShowLogs, Mode=TwoWay}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Text="Предпросмотр" FontSize="23" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="22,16,22,16" />
                  <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
                  <StackPanel>
                    <Border Margin="20" Padding="14" BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="24" Margin="0,0,12,0" CornerRadius="4">
                          <Grid>
                            <TextBlock Text="DE" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <Image Source="pack://application:,,,/ElyProxy;component/Assets/Flags/de.png" Stretch="UniformToFill">
                              <Image.Style>
                                <Style TargetType="Image">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerBadgeMode}" Value="Flag">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Image.Style>
                            </Image>
                          </Grid>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerBadgeMode}" Value="None">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Германия · Frankfurt" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis" ToolTip="Германия · Frankfurt" />
                        <Button Content="Подключиться" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" HorizontalAlignment="Right" Click="PreviewConnect_Click" Grid.Column="2" FontSize="15" MinHeight="40" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="ProtectionPanel" Visibility="Collapsed">
          <TextBlock x:Name="ProtectionAnchor" Text="Защита подписки" Style="{StaticResource SettingsSectionTitle}" Margin="0,26,0,5" />
          <TextBlock Text="Управление торрент-клиентами во время работы ElyProxy." FontSize="15" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <Border Style="{StaticResource AppleSettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Блокировать Torrent" Style="{StaticResource Text.BodyStrong}" FontSize="22" />
                      <controls:InfoHint Text="Проверяет имена запущенных процессов раз в секунду и принудительно завершает известные торрент-клиенты: qBittorrent, µTorrent, BitTorrent, Transmission, Deluge, Tixati, BitComet и другие. Переименованные клиенты и торренты внутри браузера не определяются. Это не сетевой фильтр и не гарантия от блокировки сервисом." />
                    </StackPanel>
                    <TextBlock Text="Закрывает торрент-клиенты сразу и при повторном запуске, даже без подключения к VPN. Загрузки прерываются. Работает, пока ElyProxy открыт." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TorrentProtectionStatus}" Style="{StaticResource Text.CaptionStrong}" Margin="0,8,0,0" />
                  </StackPanel>
                  <controls:SpringToggleSwitch Grid.Column="1" IsChecked="{Binding BlockTorrent, Mode=TwoWay}" AutomationProperties.Name="Блокировать Torrent" />
                </Grid>
              </Border>
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
              <Border Padding="22,18">
                <StackPanel>
                  <TextBlock Text="Когда включено" FontSize="18" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7" />
                  <TextBlock Text="Проверка запущенных процессов каждую секунду. Загрузки прерываются; при повторном запуске клиент закрывается снова." FontSize="14" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
              <Border Padding="22,18">
                <StackPanel>
                  <TextBlock Text="Работает, пока ElyProxy открыт." FontSize="18" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7" />
                  <TextBlock Text="Функция действует и при отключённом VPN." FontSize="14" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
              <Border Padding="22,18">
                <StackPanel>
                  <StackPanel>
                    <TextBlock Text="Что определяется" FontSize="18" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock Text="Известные торрент-клиенты:" FontSize="14" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="qBittorrent" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="µTorrent" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="BitTorrent" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="Transmission" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="Deluge" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="Tixati" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBr}" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,8,10,0">
                      <TextBlock Text="BitComet" FontSize="14" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="Переименованные клиенты и торренты в браузере могут не определяться. Это не сетевой фильтр." FontSize="14" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
          <TextBlock x:Name="StartupAnchor" Text="Запуск" Style="{StaticResource SettingsSectionTitle}" Margin="0,26,0,5" />
          <TextBlock Text="Автоматизация подключения и восстановление связи." FontSize="15" Foreground="{DynamicResource FgSecBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="При запуске" FontSize="23" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="22,16,22,16" />
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Grid.Column="0" Text="Запускать вместе с Windows" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <TextBlock Text="Открывать ElyProxy после входа в систему." Style="{StaticResource Text.Caption}" Margin="0,7,0,0" />
                  </StackPanel>
                  <controls:SpringToggleSwitch Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Запускать вместе с Windows" IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Grid.Column="0" Text="Подключаться к последнему серверу" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <TextBlock Text="Использовать последнее сохранённое подключение." Style="{StaticResource Text.Caption}" Margin="0,7,0,0" />
                  </StackPanel>
                  <controls:SpringToggleSwitch Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Подключаться к последнему серверу" IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Восстановление соединения" FontSize="23" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="22,16,22,16" />
              <Border Height="1" Margin="22,0" Background="{DynamicResource BorderBr}" />

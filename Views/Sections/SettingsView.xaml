                </StackPanel>
              </Border>
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <TextBlock Text="Задержка noise, мс" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Пауза после пакета, например 10-16." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="Задержка noise"
                           Text="{Binding NoiseDelay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Подмена ClientHello (spoof)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="Перед настоящим TLS-рукопожатием отправляется поддельный ClientHello. Экспериментальная техника против некоторых фильтров DPI; строгий белый список IP и отсутствие связи она не устраняет. Работает только с ядром sing-box и требует прав администратора при подключении; для Xray, Hysteria и tun2proxy с Xray-бэкендом настройка не применяется. Может ломать соединение с частью серверов — сначала попробуйте обычную фрагментацию." />
                  </StackPanel>
                  <TextBlock Text="Только sing-box; нужен запуск от администратора." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <controls:SpringToggleSwitch Grid.Column="1"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Подмена ClientHello"
                                              IsChecked="{Binding TlsSpoofEnabled, Mode=TwoWay}" />
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding TlsSpoofEnabled, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Разрешённый SNI" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="Домен, который фильтр считает разрешённым и пропускает без блокировки. Подставьте популярный сервис, доступный у вашего провайдера (например, www.google.com или www.microsoft.com). Чем ближе этот домен к реальному трафику, тем лучше." />
                  </StackPanel>
                  <TextBox Margin="0,8,0,0"
                           controls:Placeholder.Text="www.google.com"
                           AutomationProperties.Name="Разрешённый SNI для подмены"
                           Text="{Binding TlsSpoofSni, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Метод отбрасывания подделки" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="Как настоящий сервер отбросит поддельный пакет, чтобы он не долетел до него: wrong-sequence (по умолчанию) — неверный номер последовательности; wrong-checksum — плохая контрольная сумма; wrong-ack — неверное подтверждение; wrong-md5 — подпись TCP-MD5; wrong-timestamp — устаревшая метка времени. Если фильтр пропускает первый вариант, попробуйте другой." />
                  </StackPanel>
                  <ComboBox Margin="0,8,0,0"
                            AutomationProperties.Name="Метод подмены ClientHello"
                            SelectedIndex="{Binding TlsSpoofMethodIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="wrong-sequence (по умолчанию)" />
                    <ComboBoxItem Content="wrong-checksum" />
                    <ComboBoxItem Content="wrong-ack" />
                    <ComboBoxItem Content="wrong-md5" />
                    <ComboBoxItem Content="wrong-timestamp" />
                  </ComboBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>


        </Expander></StackPanel>
<StackPanel x:Name="CoresPanel" Visibility="Collapsed"><TextBlock x:Name="CoresAnchor" Text="Ядра" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />

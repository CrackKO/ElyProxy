<UserControl x:Class="ElyProxy.Views.Sections.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ElyProxy.Controls"
             xmlns:behaviors="clr-namespace:ElyProxy.Controls.Behaviors" Background="{DynamicResource Bg1Brush}">
  <UserControl.Resources>
    <Style x:Key="SettingsTab" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,4,6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource FillSecondaryBrush}"/></Trigger>
          <Trigger Property="Tag" Value="Selected"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentMutedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}"/><Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{DynamicResource FgBrush}" Background="{DynamicResource CardBrush}" HorizontalContentAlignment="Left" Padding="16,12">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="›" Margin="0,0,10,0" Foreground="{TemplateBinding Foreground}"/><ContentPresenter/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,10,0,0"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="26,22,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Настройки" Style="{StaticResource Text.LargeTitle}"/><TextBlock Text="Всё необходимое — в своём разделе" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="1,5,0,0"/></StackPanel>
      <TextBox x:Name="SettingsSearch" Grid.Column="1" VerticalAlignment="Center" controls:Placeholder.Text="Найти настройку…" AutomationProperties.Name="Поиск настроек" TextChanged="Search_TextChanged" />
    </Grid>
    <StackPanel Grid.Row="1"><WrapPanel x:Name="SettingsNavigation"><Button Content="Оформление" Tag="AppearanceAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Защита подписки" Tag="ProtectionAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Запуск" Tag="StartupAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Сеть" Tag="NetworkAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Обновления" Tag="UpdatesAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="ElyTun" Tag="TunAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Обход DPI" Tag="DpiAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Ядра" Tag="CoresAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Подписки" Tag="SubscriptionsAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" />
<Button Content="Разделение трафика" Tag="RoutingAnchor" Style="{StaticResource SettingsTab}" Click="JumpToSection_Click" /></WrapPanel>
      <ListBox x:Name="SearchResults" Visibility="Collapsed" MaxHeight="180" DisplayMemberPath="Title" SelectionChanged="SearchResults_SelectionChanged" Margin="0,4,0,12" />
    </StackPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" behaviors:SmoothScroll.IsEnabled="True">
      <StackPanel x:Name="SettingsPages" MaxWidth="1160" HorizontalAlignment="Stretch" Margin="0,8,16,0"><StackPanel x:Name="AppearancePanel" Visibility="Collapsed"><TextBlock x:Name="AppearanceAnchor" Text="Оформление" Style="{StaticResource Text.SectionHeader}" />
        <Border Style="{StaticResource AppleInsetGroup}">
          <StackPanel>
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Тема" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Светлая, тёмная или как в Windows" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                           Width="250"
                          HorizontalAlignment="Right"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          AutomationProperties.Name="Тема оформления"
                          ItemsSource="{Binding ThemeModeOptions}"
                          SelectedValue="{Binding ThemeMode, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Анимации" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Пружинные переходы; отключаются в режиме экономии" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                           Width="250"
                          HorizontalAlignment="Right"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          AutomationProperties.Name="Анимации интерфейса"
                          ItemsSource="{Binding MotionModeOptions}"
                          SelectedValue="{Binding MotionMode, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Аватар сервера" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Метка слева от названия в списках серверов и профилей"
                             Style="{StaticResource Text.Caption}"
                             Margin="0,2,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                           Width="250"
                          HorizontalAlignment="Right"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          AutomationProperties.Name="Аватар сервера"
                          ItemsSource="{Binding ServerBadgeOptions}"
                          SelectedValue="{Binding ServerBadgeMode, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Показывать журнал" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Сворачиваемая панель внизу окна (Ctrl+L)" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <controls:SpringToggleSwitch Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Показывать журнал"
                                             IsChecked="{Binding ShowLogs, Mode=TwoWay}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        </StackPanel>
<StackPanel x:Name="ProtectionPanel" Visibility="Collapsed"><TextBlock x:Name="ProtectionAnchor" Text="Защита подписки" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />
        <Border Style="{StaticResource AppleCard}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Блокировать Torrent" Style="{StaticResource Text.BodyStrong}" />
                <controls:InfoHint Text="Проверяет имена запущенных процессов раз в секунду и принудительно завершает известные торрент-клиенты: qBittorrent, µTorrent, BitTorrent, Transmission, Deluge, Tixati, BitComet и другие. Переименованные клиенты и торренты внутри браузера не определяются. Это не сетевой фильтр и не гарантия от блокировки сервисом." />
              </StackPanel>
              <TextBlock Text="Закрывает торрент-клиенты сразу и при повторном запуске, даже без подключения к VPN. Загрузки прерываются. Работает, пока ElyProxy открыт."
                         Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{Binding TorrentProtectionStatus}" Style="{StaticResource Text.CaptionStrong}" Margin="0,8,0,0" />
            </StackPanel>
            <controls:SpringToggleSwitch Grid.Column="1" IsChecked="{Binding BlockTorrent, Mode=TwoWay}" AutomationProperties.Name="Блокировать Torrent" />
          </Grid>
        </Border>


        </StackPanel>
<StackPanel x:Name="StartupPanel" Visibility="Collapsed"><TextBlock x:Name="StartupAnchor" Text="Запуск" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />
        <Border Style="{StaticResource AppleInsetGroup}">
          <StackPanel>
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Запускать вместе с Windows" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                <controls:SpringToggleSwitch Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             AutomationProperties.Name="Запускать вместе с Windows"
                                             IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Подключаться к последнему серверу" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                <controls:SpringToggleSwitch Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             AutomationProperties.Name="Подключаться к последнему серверу"
                                             IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Переподключаться при обрыве" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Приложение переподключается, когда ядро падает, а также автоматически реагирует на смену сети (Wi-Fi ↔ Ethernet, появление/пропадание сети) и на пробуждение компьютера из сна. Переподключение выполняется один раз в 10 секунд, чтобы не было циклов." />
                </StackPanel>
                <controls:SpringToggleSwitch Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             AutomationProperties.Name="Переподключаться при обрыве"
                                             IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>


        </StackPanel>
<StackPanel x:Name="NetworkPanel" Visibility="Collapsed"><TextBlock x:Name="NetworkAnchor" Text="Сеть" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />
        <Border Style="{StaticResource AppleInsetGroup}">
          <StackPanel>
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="SOCKS5 порт" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Локальный прокси: socks5://127.0.0.1:порт" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <TextBox Grid.Column="1"
                          Width="110"
                         HorizontalAlignment="Right"
                         TextAlignment="Center"
                         AutomationProperties.Name="Порт SOCKS5"
                         Text="{Binding SocksPort, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Тип пинга" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Как кнопка «Пинг» проверяет серверы" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                           Width="250"
                          HorizontalAlignment="Right"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          AutomationProperties.Name="Тип пинга"
                          ItemsSource="{Binding PingModeOptions}"
                          SelectedValue="{Binding PingMode, Mode=TwoWay}" />
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding IsProxyGetPingMode, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <TextBlock Text="URL для Proxy GET" Style="{StaticResource Text.Body}" />
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="URL для Proxy GET"
                           Text="{Binding ProxyPingUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding IsProxyBasedPingMode, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Потоки" Style="{StaticResource Text.Body}" />
                    <TextBlock Text="Рекомендуется 10: больше потоков — быстрее проверка и выше нагрузка" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="110"
                           HorizontalAlignment="Right"
                           TextAlignment="Center"
                           AutomationProperties.Name="Количество потоков проверки"
                           Text="{Binding ProxyPingConcurrency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>


        </StackPanel>
<StackPanel x:Name="UpdatesPanel" Visibility="Collapsed"><TextBlock x:Name="UpdatesAnchor" Text="Обновления" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />
        <Border Style="{StaticResource AppleInsetGroup}">
          <StackPanel>
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Проверить"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CheckForUpdatesCommand}"
                        AutomationProperties.Name="Проверить обновления" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Автообновления" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding AutoUpdateDescription}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <controls:SpringToggleSwitch Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             AutomationProperties.Name="Автообновления"
                                             IsChecked="{Binding AutoUpdate, Mode=TwoWay}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>


        </StackPanel>
<StackPanel x:Name="TunPanel" Visibility="Collapsed"><TextBlock x:Name="TunAnchor" Text="ElyTun" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />
        <Border Style="{StaticResource AppleInsetGroup}">
          <StackPanel>
          <Border Style="{StaticResource AppleSettingRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Туннелировать IPv6" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Добавляет IPv6-адрес в TUN-интерфейс. Выключайте, если провайдер или сервер не поддерживает IPv6 — тогда трафик пойдёт только по IPv4 без зависаний на AAAA-запросах." />
                </StackPanel>
                <TextBlock Text="Полный TUN-режим; выключите, если провайдер не поддерживает IPv6" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <controls:SpringToggleSwitch Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="Туннелировать IPv6"
                                           IsChecked="{Binding ElyTunIpv6Enabled, Mode=TwoWay}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource AppleRowSeparator}" />
          <Border Style="{StaticResource AppleSettingRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Ядро TUN" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Какой движок создаёт TUN-туннель. sing-box — универсальный: все протоколы, правила маршрутизации, обход по приложениям. Xray TUN — нативный TUN Xray в одном процессе: VLESS/VMess/Trojan/Shadowsocks, VLESS Encryption, xhttp и mKCP. tun2proxy — TUN поверх локального SOCKS/mixed: максимальная совместимость, но без обхода по приложениям и без собственной маршрутизации по доменам. Hysteria 2 TUN — встроенный TUN ядра Hysteria: только для нод hysteria2, правила ElyTun и профиль RoscomVPN не применяются." />
                </StackPanel>
                <TextBlock Text="{Binding TunCoreDescription}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Ядро TUN"
                        SelectedIndex="{Binding TunCoreIndex, Mode=TwoWay}">
                <ComboBoxItem Content="sing-box" />
                <ComboBoxItem Content="Xray TUN" />
                <ComboBoxItem Content="tun2proxy" />
                <ComboBoxItem Content="Hysteria 2 TUN" />
              </ComboBox>
            </Grid>
          </Border>
          <Border Style="{StaticResource AppleRowSeparator}" />
          <Border Style="{StaticResource AppleSettingRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Служба-помощник (без UAC)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Зачем: чтобы ElyTun включался без запроса прав администратора каждый раз. Как это работает: вы один раз устанавливаете службу ElyProxyHelper (Windows попросит UAC один раз) — дальше TUN-ядра запускает служба от имени системы, и запросов прав больше нет. Как проверить: под переключателем статус должен быть «Служба запущена». Если служба не установлена или остановлена, ElyProxy тихо работает как раньше — с UAC при каждом включении ElyTun. Безопасность: служба принимает только известные ядра ElyProxy (xray, sing-box, tun2proxy, hysteria) и останавливает их при отключении. Удаление — кнопкой «Удалить», тогда права снова будут запрашиваться." />
                </StackPanel>
                <TextBlock Text="{Binding HelperServiceDescription}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding HelperServiceStatus}" Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="250">
                <controls:SpringToggleSwitch HorizontalAlignment="Right"
                                              AutomationProperties.Name="TUN через службу-помощник"
                                              IsChecked="{Binding UseHelperService, Mode=TwoWay}" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0" MaxWidth="250">
                  <Button Content="Установить"
                          Style="{StaticResource SecondaryButton}"
                          IsEnabled="{Binding IsHelperAvailable}"
                          Margin="0,0,6,6"
                          Command="{Binding InstallHelperCommand}"
                          AutomationProperties.Name="Установить службу-помощник" />
                  <Button Content="Удалить"
                          Style="{StaticResource GhostButton}"
                          Margin="0,0,6,6"
                          Command="{Binding UninstallHelperCommand}"
                          AutomationProperties.Name="Удалить службу-помощник" />
                  <Button Content="Обновить статус"
                          Style="{StaticResource GhostButton}"
                          Margin="0,0,0,6"
                          Command="{Binding RefreshHelperStatusCommand}"
                          AutomationProperties.Name="Обновить статус службы-помощника" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          </StackPanel>
        </Border>


        </StackPanel>
<StackPanel x:Name="DpiPanel" Visibility="Collapsed"><TextBlock x:Name="DpiAnchor" Text="Обход DPI" Style="{StaticResource Text.SectionHeader}" Margin="2,0,0,16" />

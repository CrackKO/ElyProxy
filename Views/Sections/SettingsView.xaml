                </StackPanel>
                <TextBlock Text="Скачивает свежие Xray, sing-box, tun2proxy и Hysteria 2 с GitHub, проверяет SHA-256 и кладёт в локальную папку ElyProxy." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />

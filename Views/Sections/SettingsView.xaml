                  </StackPanel>
                  <TextBlock Text="Дробит TLS ClientHello, чтобы обойти SNI-фильтры. Может замедлить соединение." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />

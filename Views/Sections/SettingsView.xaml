                  <ComboBoxItem Content="Стандартный" />
                  <ComboBoxItem Content="Свой" />
                </ComboBox>
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding IsCustomFragment, Converter={StaticResource BoolToVis}}">

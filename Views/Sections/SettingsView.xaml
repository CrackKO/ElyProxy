                </StackPanel>
              </Border>
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <TextBlock Text="Интервал, мс" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Пауза между фрагментами, например 10-20." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="Интервал фрагментации"
                           Text="{Binding FragmentInterval, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дробить TLS-записи (sing-box)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="Только для sing-box (VLESS/VMess/Trojan). Дробит TLS-рукопожатие на отдельные TLS-записи — это быстрее полной фрагментации. Включайте, если провайдер фильтрует по SNI, но полная фрагментация заметно замедляет соединение. Для Xray настройка не применяется." />
                  </StackPanel>
                  <TextBlock Text="Быстрее полной фрагментации; применяется к VLESS/VMess/Trojan." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <controls:SpringToggleSwitch Grid.Column="1"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Дробить TLS-записи"
                                              IsChecked="{Binding FragmentRecord, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Noise-пакеты (Xray)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="Только для Xray и только при включённой фрагментации. Перед реальными данными отправляются «шумовые» пакеты, чтобы сбить сигнатуры DPI. rand — случайные байты (в поле укажите длину, например 50-150), str — произвольная строка, base64 — данные в base64. Слишком агрессивные значения могут мешать соединению." />
                  </StackPanel>
                  <TextBlock Text="Случайные пакеты перед данными; работает при включённой фрагментации." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="250"
                          HorizontalAlignment="Right"
                          AutomationProperties.Name="Тип noise-пакетов"
                          SelectedIndex="{Binding NoiseTypeIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="Выключено" />
                  <ComboBoxItem Content="rand" />
                  <ComboBoxItem Content="str" />
                  <ComboBoxItem Content="base64" />
                </ComboBox>
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding IsNoiseEnabled, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <TextBlock Text="Содержимое пакета" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Для rand — длина (50-150), для str — строка, для base64 — данные." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="Содержимое noise-пакета"

                </StackPanel>
              </Border>
              <Border Style="{StaticResource AppleRowSeparator}" />
              <Border Style="{StaticResource AppleSettingRow}">
                <StackPanel>
                  <TextBlock Text="Длина фрагмента" Style="{StaticResource Text.Body}" />
                  <TextBlock Text="Диапазон в байтах, например 100-200." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />

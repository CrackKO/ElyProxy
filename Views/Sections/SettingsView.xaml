                             GroupName="ElyTunRoutingPreset"
                             AutomationProperties.Name="Профиль маршрутизации: свои правила"
                             IsChecked="{Binding UseCustomRouting, Mode=TwoWay}" />
                <RadioButton Content="RoscomVPN DEFAULT — встроенный готовый набор"
                             Margin="0,8,0,0"
                             GroupName="ElyTunRoutingPreset"
                             AutomationProperties.Name="Профиль маршрутизации: RoscomVPN DEFAULT"
                             IsChecked="{Binding UseRoscomVpnDefaultRouting, Mode=TwoWay}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Bypass-правила для Proxy Lite, Proxy Pro и ElyTun" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Домены, *.домены, IP и CIDR, которые всегда идут напрямую. Работают во всех режимах. В профиле RoscomVPN DEFAULT эти правила добавляются поверх встроенных и имеют приоритет. Для Xray-бэкенда tun2proxy правила применяются к доменам и IP." />
                </StackPanel>
                <TextBlock Text="По одному правилу в строке: домен, *.домен, IP или CIDR. Эти адреса идут напрямую."
                           Style="{StaticResource Text.Caption}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBox AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="120"
                         Margin="0,10,0,0"
                         FontFamily="{StaticResource AppMonoFontFamily}"
                         FontSize="12"
                         AutomationProperties.Name="Правила разделения трафика"
                         Text="{Binding SystemProxyRulesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Grid Margin="0,10,0,0">
                  <TextBlock Text="Proxy Pro применяет те же правила, что и ElyTun, но через системный прокси без TUN."
                             Style="{StaticResource Text.Micro}"
                             TextWrapping="Wrap"
                             MaxWidth="480"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                  <Button Content="Сбросить правила"
                          Style="{StaticResource GhostButton}"
                          HorizontalAlignment="Right"
                          Command="{Binding ResetSystemProxyRulesCommand}"
                          AutomationProperties.Name="Сбросить правила разделения трафика" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}" IsEnabled="{Binding IsPerAppSupported}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Режим приложений" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    <controls:InfoHint Text="«Исключать выбранные» — перечисленные .exe идут напрямую, остальное через прокси. «Только выбранные» — наоборот: через прокси идут только они, остальной трафик напрямую, а профиль RoscomVPN и доменные правила не применяются. Ядро tun2proxy не умеет работать по приложениям — для него режим и список будут недоступны." />
                  </StackPanel>
                  <TextBlock Text="{Binding PerAppModeDescription}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="250"
                          HorizontalAlignment="Right"
                          AutomationProperties.Name="Режим обхода по приложениям"
                          SelectedIndex="{Binding PerAppModeIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="Исключать выбранные" />
                  <ComboBoxItem Content="Только выбранные" />
                </ComboBox>
              </Grid>
            </Border>
            <Border Style="{StaticResource AppleRowSeparator}" />
            <Border Style="{StaticResource AppleSettingRow}" IsEnabled="{Binding IsPerAppSupported}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Обход по приложениям" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                  <controls:InfoHint Text="Список .exe для правил по приложениям. В ElyTun (sing-box и Xray TUN) сопоставление идёт по полному пути процесса, поэтому выбирайте файл из папки установки. В Proxy Pro правило срабатывает для процесса, чей трафик пришёл в системный прокси. PAC (Proxy Lite) имя приложения не передаёт, поэтому список там не действует. Ядро tun2proxy не поддерживает per-app — список будет недоступен." />
                </StackPanel>
                <TextBlock Text="В ElyTun весь трафик выбранного .exe идёт напрямую, независимо от доменных/IP-правил. В Proxy Pro правило действует на трафик, поступающий в системный прокси. Proxy Lite (PAC) не передаёт имя приложения."
                           Style="{StaticResource Text.Caption}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <ListView Style="{StaticResource AppleListView}"
                          ScrollViewer.CanContentScroll="False"
                          ItemsSource="{Binding ApplicationBypassApplications}"
                          SelectedItem="{Binding SelectedApplicationBypass, Mode=TwoWay}"
                          Height="130"
                          Margin="0,10,0,0"
                          AutomationProperties.Name="Приложения, обходящие VPN">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource Text.BodyStrong}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExecutablePath}"
                                   Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutablePath}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="Изменения сохраняются сразу. При активном VPN отключите и подключите его снова."
                             Style="{StaticResource Text.Micro}"
                             TextWrapping="Wrap"
                             MaxWidth="440"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Удалить"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RemoveApplicationBypassCommand}"
                            AutomationProperties.Name="Удалить выбранное приложение из обхода" />
                    <Button Content="Добавить приложение…"
                            Style="{StaticResource SecondaryButton}"
                            Margin="6,0,0,0"
                            Command="{Binding AddApplicationBypassCommand}"
                            AutomationProperties.Name="Добавить приложение для обхода VPN" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

</StackPanel></StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="Настройки сохраняются автоматически" Style="{StaticResource Text.Micro}" Margin="2,16,0,0"/>
  </Grid>
</UserControl>

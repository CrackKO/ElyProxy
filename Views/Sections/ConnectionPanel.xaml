<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ElyProxy.Controls" x:Class="ElyProxy.Views.Sections.ConnectionPanel">
  <Border Style="{StaticResource AppleCard}" Padding="18,14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource FillTertiaryBrush}" Margin="0,0,14,0" Visibility="{Binding ServerBadgeMode, Converter={StaticResource BadgeVis}}">
        <Grid>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.CaptionStrong}"><TextBlock.Text><MultiBinding Converter="{StaticResource BadgeText}"><Binding Path="ConnectionPanelNode.DisplayName"/><Binding Path="ServerBadgeMode"/></MultiBinding></TextBlock.Text></TextBlock>
          <Image Panel.ZIndex="1" Stretch="UniformToFill">
          <Image.Source><MultiBinding Converter="{StaticResource FlagImage}"><Binding Path="ConnectionPanelNode.DisplayName"/><Binding Path="ServerBadgeMode"/></MultiBinding></Image.Source>
            <Image.Clip>
              <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
            </Image.Clip>
          </Image>
        </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="0,0,12,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding ConnectionPanelName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionPanelName}"/>
          <TextBlock Grid.Row="1" Text="{Binding ConnectionPanelSource}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionPanelSource}" Margin="0,5,0,0"/>
          <TextBlock Grid.Row="2" x:Name="SessionLabel" Style="{StaticResource Text.Micro}" Margin="0,3,0,0"/>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="210" Visibility="{Binding IsTrafficMonitorActive, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource Text.BodyStrong}" ToolTip="{Binding SessionTrafficText}">
            <Run Text="↓ " Foreground="{DynamicResource AccentBrush}"/>
            <Run Text="{Binding DownloadSpeedText, Mode=OneWay}"/>
            <Run Text="   ↑ " Foreground="{DynamicResource GreenBrush}"/>
            <Run Text="{Binding UploadSpeedText, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <Grid Grid.Column="3" VerticalAlignment="Center">
          <Button Content="Подключиться" MinWidth="142" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"/>
          <Button Content="Отключиться" MinWidth="142" Style="{StaticResource PrimaryButton}" Command="{Binding DisconnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
        </Grid>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="Режим подключения" Style="{StaticResource Text.CaptionStrong}" VerticalAlignment="Center"/>
          <controls:InfoHint Text="Proxy Lite — выбранные сайты через PAC. Proxy Pro — системный прокси Windows. ElyTun — весь трафик через TUN; нужны права администратора или служба-помощник. Ядро выбирается в настройках."/>
        </StackPanel>
        <controls:ModeSelector Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Режим подключения" ElyTunRequestCommand="{Binding RequestElyTunCommand}" ProxyLiteEnabled="{Binding SystemProxyEnabled, Mode=TwoWay}" ProxyProEnabled="{Binding ProxyProEnabled, Mode=TwoWay}" ElyTunEnabled="{Binding ElyTunEnabled, Mode=TwoWay}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>

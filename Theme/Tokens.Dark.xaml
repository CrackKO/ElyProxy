<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Apple dark palette. Every brush here must be referenced with DynamicResource
       so ThemeService can swap this dictionary at runtime. -->

  <Color x:Key="Accent">#0A84FF</Color>
  <Color x:Key="AccentHover">#409CFF</Color>
  <Color x:Key="AccentPressed">#0060DF</Color>
  <Color x:Key="AccentMuted">#330A84FF</Color>

  <Color x:Key="Bg1">#000000</Color>
  <Color x:Key="Bg2">#1C1C1E</Color>
  <Color x:Key="Bg3">#2C2C2E</Color>
  <Color x:Key="Bg4">#3A3A3C</Color>
  <Color x:Key="CardBg">#1C1C1E</Color>
  <Color x:Key="CardHoverBg">#2C2C2E</Color>

  <Color x:Key="FgPrimary">#FFFFFF</Color>
  <Color x:Key="FgSecondary">#99EBEBF5</Color>
  <Color x:Key="FgDim">#4DEBEBF5</Color>
  <Color x:Key="FgQuaternary">#2EEBEBF5</Color>

  <Color x:Key="Border">#3D3D41</Color>
  <Color x:Key="Green">#30D158</Color>
  <Color x:Key="GreenHover">#4CD964</Color>
  <Color x:Key="Red">#FF453A</Color>
  <Color x:Key="RedHover">#FF6961</Color>
  <Color x:Key="Orange">#FF9F0A</Color>
  <Color x:Key="Yellow">#FFD60A</Color>
  <Color x:Key="Teal">#64D2FF</Color>

  <!-- Material tints layered over the DWM Mica/Acrylic backdrop -->
  <Color x:Key="MaterialThin">#66000000</Color>
  <Color x:Key="MaterialRegular">#CC1C1C1E</Color>
  <Color x:Key="MaterialThick">#F21C1C1E</Color>
  <Color x:Key="Scrim">#80000000</Color>
  <Color x:Key="Skeleton">#1FFFFFFF</Color>

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMuted}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}" />
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBg}" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverBg}" />

  <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgPrimary}" />
  <SolidColorBrush x:Key="FgSecBrush" Color="{StaticResource FgSecondary}" />
  <SolidColorBrush x:Key="FgDimBrush" Color="{StaticResource FgDim}" />
  <SolidColorBrush x:Key="FgQuaternaryBrush" Color="{StaticResource FgQuaternary}" />

  <SolidColorBrush x:Key="BorderBr" Color="{StaticResource Border}" />
  <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
  <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHover}" />
  <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
  <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHover}" />
  <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource Orange}" />
  <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource Yellow}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource Teal}" />

  <SolidColorBrush x:Key="MaterialThinBrush" Color="{StaticResource MaterialThin}" />
  <!-- Shell surface (sidebar/title bar). ThemeService swaps it between the
       translucent material and an opaque fill depending on the backdrop mode. -->
  <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{StaticResource MaterialThin}" />
  <SolidColorBrush x:Key="MaterialRegularBrush" Color="{StaticResource MaterialRegular}" />
  <SolidColorBrush x:Key="MaterialThickBrush" Color="{StaticResource MaterialThick}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />
  <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource Skeleton}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource AccentMuted}" />

  <!-- Control fills: translucent greys used by inputs and secondary buttons -->
  <!-- Soft top-to-bottom wash for the content area: a barely visible lift that
       gives the flat black some depth without looking like a gradient. -->
  <LinearGradientBrush x:Key="ContentSurfaceBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF0E1117" Offset="0" />
    <GradientStop Color="#FF000000" Offset="0.45" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="FillBrush" Color="#5C767680" />
  <SolidColorBrush x:Key="FillSecondaryBrush" Color="#3D767680" />
  <SolidColorBrush x:Key="FillTertiaryBrush" Color="#2E767680" />
  <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="GreenMutedBrush" Color="#3330D158" />
  <SolidColorBrush x:Key="RedMutedBrush" Color="#33FF453A" />
  <SolidColorBrush x:Key="OrangeMutedBrush" Color="#33FF9F0A" />

</ResourceDictionary>

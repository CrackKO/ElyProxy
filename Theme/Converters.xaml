<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ElyProxy.Controls.Converters">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <converters:InverseBoolConverter x:Key="InverseBool" />
  <converters:ZeroToVisibilityConverter x:Key="ZeroToVis" />
  <converters:NonZeroToVisibilityConverter x:Key="NonZeroToVis" />
  <converters:NullToVisibilityConverter x:Key="NullToVis" />
  <converters:StringToVisibilityConverter x:Key="StringToVis" />
  <converters:BoolAndZeroToVisibilityConverter x:Key="BoolAndZeroToVis" />
  <converters:ComboLabelConverter x:Key="ComboLabel" />
  <converters:BadgeTextConverter x:Key="BadgeText" />
  <converters:BadgeVisibilityConverter x:Key="BadgeVis" />

  <Style x:Key="AppleFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderThickness="3"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource AccentBrush}"
                  Opacity="0.85"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <CornerRadius x:Key="Radius.Card">14</CornerRadius>
  <CornerRadius x:Key="Radius.Control">9</CornerRadius>
  <CornerRadius x:Key="Radius.Small">7</CornerRadius>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: cards, inset groups, chips, pills, skeletons. -->

  <Style x:Key="AppleCard" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AppleInsetGroup" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AppleSettingRow" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AppleRowSeparator" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource BorderBr}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Chip" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource FillTertiaryBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="ChipText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style x:Key="StatusPill" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource FillTertiaryBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="StatusPillAccent" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusPill}">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
  </Style>

  <Style x:Key="StatusPillGreen" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusPill}">
    <Setter Property="Background" Value="{DynamicResource GreenMutedBrush}" />
  </Style>

  <Style x:Key="StatusPillRed" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusPill}">
    <Setter Property="Background" Value="{DynamicResource RedMutedBrush}" />
  </Style>

  <Style x:Key="StatusPillOrange" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusPill}">
    <Setter Property="Background" Value="{DynamicResource OrangeMutedBrush}" />
  </Style>

  <Style x:Key="PillText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FgSecBrush}" />
  </Style>

  <Style x:Key="PillTextGreen" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PillText}">
    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
  </Style>

  <Style x:Key="PillTextRed" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PillText}">
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
  </Style>

  <Style x:Key="PillTextAccent" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PillText}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style x:Key="IconTile" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource FillTertiaryBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="SkeletonBlock" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SkeletonBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.55"
                             To="1"
                             Duration="0:0:0.9" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>

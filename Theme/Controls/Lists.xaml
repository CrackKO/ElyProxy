<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ElyProxy.Controls.Behaviors">

  <!-- Lists, overlay scrollbars. Selection uses a tinted accent fill so that
       secondary text stays legible (see skill: vibrancy over materials). -->

  <ControlTemplate x:Key="TransparentRepeatButton" TargetType="{x:Type RepeatButton}">
    <Border Background="Transparent" />
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Track x:Name="PART_Track"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand"
                              Focusable="False"
                              Template="{StaticResource TransparentRepeatButton}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand"
                              Focusable="False"
                              Template="{StaticResource TransparentRepeatButton}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border x:Name="ThumbBd"
                              Width="6"
                              Height="6"
                              CornerRadius="3"
                              Background="{DynamicResource FgDimBrush}"
                              Opacity="0.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="True" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbBd" Property="Opacity" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10" />
              <Setter Property="MinHeight" Value="10" />
              <Setter TargetName="Thumb" Property="Width" Value="Auto" />
              <Setter TargetName="Thumb" Property="Height" Value="6" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter Property="Width" Value="10" />
              <Setter TargetName="Thumb" Property="Width" Value="6" />
              <Setter TargetName="Thumb" Property="Height" Value="Auto" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="AppleListItemTemplate" TargetType="{x:Type ListBoxItem}">
    <Grid Margin="0,1">
      <Border x:Name="Bd"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Control}"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
        <ContentPresenter VerticalAlignment="Center" />
      </Border>
      <Border x:Name="SelectionBar"
              Width="3"
              Height="18"
              CornerRadius="1.5"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{DynamicResource AccentBrush}"
              Opacity="0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillTertiaryBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="AppleListViewItemTemplate" TargetType="{x:Type ListViewItem}">
    <Grid Margin="0,1">
      <Border x:Name="Bd"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Control}"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
        <ContentPresenter VerticalAlignment="Center" />
      </Border>
      <Border x:Name="SelectionBar"
              Width="3"
              Height="18"
              CornerRadius="1.5"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{DynamicResource AccentBrush}"
              Opacity="0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillTertiaryBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="AppleListTemplate" TargetType="{x:Type ListBox}">
    <ScrollViewer Focusable="False"
                  Padding="{TemplateBinding Padding}"
                  behaviors:SmoothScroll.IsEnabled="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsPresenter />
    </ScrollViewer>
  </ControlTemplate>

  <Style x:Key="AppleList" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <!-- Pixel scrolling so the smooth-scroll spring can work in pixels. -->
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12,9" />
          <Setter Property="FocusVisualStyle" Value="{StaticResource AppleFocusVisual}" />
          <Setter Property="Template" Value="{StaticResource AppleListItemTemplate}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template" Value="{StaticResource AppleListTemplate}" />
  </Style>

  <Style x:Key="AppleListView" TargetType="{x:Type ListView}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <!-- Pixel scrolling so the smooth-scroll spring can work in pixels. -->
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="{x:Type ListViewItem}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12,9" />
          <Setter Property="FocusVisualStyle" Value="{StaticResource AppleFocusVisual}" />
          <Setter Property="Template" Value="{StaticResource AppleListViewItemTemplate}" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListView}">
          <ScrollViewer Focusable="False"
                        Padding="{TemplateBinding Padding}"
                        behaviors:SmoothScroll.IsEnabled="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

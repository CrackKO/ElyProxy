<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- High contrast palette. Mirrors Theme/Tokens.Dark.xaml key for key, but maps
       everything onto the Windows system colors so the app stays usable when the
       user runs a contrast theme. Surfaces are opaque by design. -->

  <Color x:Key="Accent">{x:Static SystemColors.HighlightColor}</Color>
  <Color x:Key="AccentHover">{x:Static SystemColors.HighlightColor}</Color>
  <Color x:Key="AccentPressed">{x:Static SystemColors.HighlightColor}</Color>
  <Color x:Key="AccentMuted">{x:Static SystemColors.HighlightColor}</Color>

  <Color x:Key="Bg1">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="Bg2">{x:Static SystemColors.ControlColor}</Color>
  <Color x:Key="Bg3">{x:Static SystemColors.ControlColor}</Color>
  <Color x:Key="Bg4">{x:Static SystemColors.ControlColor}</Color>
  <Color x:Key="CardBg">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="CardHoverBg">{x:Static SystemColors.ControlColor}</Color>

  <Color x:Key="FgPrimary">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="FgSecondary">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="FgDim">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="FgQuaternary">{x:Static SystemColors.WindowTextColor}</Color>

  <Color x:Key="Border">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="Green">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="GreenHover">{x:Static SystemColors.HighlightColor}</Color>
  <Color x:Key="Red">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="RedHover">{x:Static SystemColors.HighlightColor}</Color>
  <Color x:Key="Orange">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="Yellow">{x:Static SystemColors.WindowTextColor}</Color>
  <Color x:Key="Teal">{x:Static SystemColors.WindowTextColor}</Color>

  <Color x:Key="MaterialThin">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="MaterialRegular">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="MaterialThick">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="Scrim">{x:Static SystemColors.WindowColor}</Color>
  <Color x:Key="Skeleton">{x:Static SystemColors.ControlColor}</Color>

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMuted}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource FgPrimary}" />

  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}" />
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBg}" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverBg}" />

  <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgPrimary}" />
  <SolidColorBrush x:Key="FgSecBrush" Color="{StaticResource FgSecondary}" />
  <SolidColorBrush x:Key="FgDimBrush" Color="{StaticResource FgDim}" />
  <SolidColorBrush x:Key="FgQuaternaryBrush" Color="{StaticResource FgQuaternary}" />

  <SolidColorBrush x:Key="BorderBr" Color="{StaticResource Border}" />
  <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
  <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHover}" />
  <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
  <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource RedHover}" />
  <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource Orange}" />
  <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource Yellow}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource Teal}" />

  <SolidColorBrush x:Key="MaterialThinBrush" Color="{StaticResource MaterialThin}" />
  <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{StaticResource MaterialThin}" />
  <SolidColorBrush x:Key="MaterialRegularBrush" Color="{StaticResource MaterialRegular}" />
  <SolidColorBrush x:Key="MaterialThickBrush" Color="{StaticResource MaterialThick}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />
  <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource Skeleton}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource AccentMuted}" />

  <LinearGradientBrush x:Key="ContentSurfaceBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="{StaticResource Bg1}" Offset="0" />
    <GradientStop Color="{StaticResource Bg1}" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="FillBrush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="FillSecondaryBrush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="FillTertiaryBrush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="SwitchThumbBrush" Color="{StaticResource FgPrimary}" />
  <SolidColorBrush x:Key="GreenMutedBrush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="RedMutedBrush" Color="{StaticResource Bg2}" />
  <SolidColorBrush x:Key="OrangeMutedBrush" Color="{StaticResource Bg2}" />

</ResourceDictionary>
